<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Няшка Дроп | Легендарные Кейсы</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Bebas+Neue&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #0a0410;
            --bg-panel: #140824;
            --bg-card: #1a0f2e;
            --purple-1: #7c3aed;
            --purple-2: #a855f7;
            --purple-3: #c084fc;
            --purple-glow: rgba(168, 85, 247, 0.5);
            --gold-1: #fbbf24;
            --gold-2: #f59e0b;
            --green: #10b981;
            --red: #ef4444;
            --blue: #3b82f6;
            --text-main: #ffffff;
            --text-muted: #8a7fa8;
            --border-subtle: rgba(168, 85, 247, 0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body { background: var(--bg-deep); color: var(--text-main); min-height: 100vh; overflow-x: hidden; }

        /* --- Стеклянные панели --- */
        .glass { background: rgba(20, 8, 36, 0.7); backdrop-filter: blur(20px); border: 1px solid var(--border-subtle); border-radius: 20px; }

        /* --- Авторизация --- */
        #auth-screen { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: radial-gradient(circle at 50% 0%, #2a1045 0%, #0a0410 70%); padding: 20px; }
        .auth-box { width: 100%; max-width: 400px; padding: 40px 30px; text-align: center; animation: fadeIn 0.6s ease; }
        .auth-box h1 { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 4px; background: linear-gradient(180deg, #fff, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 10px; }
        .auth-box p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 30px; }
        .auth-input { width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 15px; color: #fff; font-size: 1rem; margin-bottom: 15px; outline: none; transition: 0.3s; }
        .auth-input:focus { border-color: var(--purple-2); box-shadow: 0 0 15px var(--purple-glow); }
        .auth-btn { width: 100%; background: linear-gradient(135deg, var(--purple-1), #5b21b6); color: #fff; border: none; padding: 15px; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; }
        .auth-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 25px var(--purple-glow); }
        .auth-switch { margin-top: 20px; font-size: 0.85rem; color: var(--text-muted); cursor: pointer; }
        .auth-switch span { color: var(--purple-3); font-weight: 700; }

        /* --- Шапка --- */
        header { position: sticky; top: 0; z-index: 100; background: rgba(10, 4, 16, 0.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-subtle); padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; }
        .logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 3px; background: linear-gradient(180deg, #fff, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: flex; align-items: center; gap: 8px; }
        .header-balance { display: flex; align-items: center; gap: 8px; background: rgba(168, 85, 247, 0.1); border: 1px solid var(--purple-2); padding: 6px 16px; border-radius: 20px; font-weight: 800; color: var(--gold-1); font-size: 0.9rem; }
        .header-balance .star { color: var(--gold-1); font-size: 1.1rem; }
        .profile-btn { background: rgba(255,255,255,0.05); border: 1px solid var(--border-subtle); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; cursor: pointer; transition: 0.3s; }
        .profile-btn:hover { border-color: var(--purple-2); background: rgba(168, 85, 247, 0.2); }

        /* --- Контент --- */
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        .section-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 3px; margin: 30px 0 15px; display: flex; align-items: center; gap: 10px; }
        .section-title::before { content: ''; width: 4px; height: 24px; background: linear-gradient(180deg, var(--purple-2), var(--purple-1)); border-radius: 4px; box-shadow: 0 0 10px var(--purple-glow); }

        /* --- Кейсы --- */
        .cases-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 15px; }
        .case-card { background: linear-gradient(160deg, #1a0f2e, #0d0618); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 20px 15px; text-align: center; cursor: pointer; transition: 0.3s; position: relative; overflow: hidden; }
        .case-card:hover { transform: translateY(-5px); border-color: var(--gold-1); box-shadow: 0 15px 30px rgba(0,0,0,0.5), 0 0 20px rgba(251, 191, 36, 0.2); }
        .case-img { font-size: 3rem; margin-bottom: 10px; filter: drop-shadow(0 0 15px var(--purple-glow)); }
        .case-name { font-weight: 700; font-size: 0.85rem; margin-bottom: 5px; }
        .case-price { color: var(--gold-1); font-weight: 800; font-size: 0.9rem; }
        .case-badge { position: absolute; top: 8px; right: 8px; background: #ef4444; color: #fff; font-size: 0.6rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; }

        /* --- Инвентарь и Профиль --- */
        .inventory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
        .inv-item { background: rgba(26, 15, 46, 0.6); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 15px; text-align: center; cursor: pointer; transition: 0.3s; }
        .inv-item:hover { border-color: var(--purple-2); background: rgba(168, 85, 247, 0.1); }
        .inv-img { font-size: 2rem; margin-bottom: 8px; }
        .inv-name { font-size: 0.75rem; font-weight: 600; margin-bottom: 5px; min-height: 30px; }
        .inv-price { color: var(--gold-1); font-size: 0.8rem; font-weight: 800; }
        .rarity-common { color: #9ca3af; }
        .rarity-rare { color: #3b82f6; }
        .rarity-epic { color: #a855f7; }
        .rarity-legendary { color: #fbbf24; }
        .rarity-mythic { color: #ef4444; }

        /* --- Апгрейд --- */
        .upgrade-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
        @media (max-width: 768px) { .upgrade-container { grid-template-columns: 1fr; } }
        .upgrade-box { background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 25px; text-align: center; }
        .upgrade-box h3 { font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
        .upgrade-item-img { font-size: 4rem; margin-bottom: 10px; }
        .upgrade-item-name { font-weight: 700; font-size: 1.1rem; margin-bottom: 5px; }
        .upgrade-item-price { color: var(--gold-1); font-weight: 800; font-size: 1.2rem; }
        .chance-slider { width: 100%; margin: 20px 0; accent-color: var(--purple-2); }
        .chance-display { font-size: 2.5rem; font-family: 'Bebas Neue', sans-serif; color: var(--purple-3); letter-spacing: 2px; }
        .upgrade-btn { width: 100%; background: linear-gradient(135deg, var(--purple-1), #5b21b6); color: #fff; border: none; padding: 15px; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; text-transform: uppercase; margin-top: 15px; transition: 0.3s; }
        .upgrade-btn:hover { box-shadow: 0 10px 25px var(--purple-glow); }
        .upgrade-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        /* --- Лидеры --- */
        .leaderboard { background: var(--bg-panel); border: 1px solid var(--border-subtle); border-radius: 16px; overflow: hidden; }
        .lb-row { display: flex; align-items: center; justify-content: space-between; padding: 15px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .lb-row:last-child { border-bottom: none; }
        .lb-rank { font-weight: 800; color: var(--purple-3); width: 30px; }
        .lb-name { flex: 1; font-weight: 600; }
        .lb-stars { color: var(--gold-1); font-weight: 800; }

        /* --- Админ-панель --- */
        #admin-panel { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); z-index: 1000; padding: 20px; overflow-y: auto; }
        .admin-content { max-width: 800px; margin: 40px auto; background: var(--bg-panel); border: 1px solid var(--purple-2); border-radius: 20px; padding: 30px; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 15px; }
        .admin-header h2 { font-family: 'Bebas Neue', sans-serif; letter-spacing: 2px; color: var(--gold-1); }
        .close-admin { background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; }
        .admin-section { margin-bottom: 25px; }
        .admin-section h3 { font-size: 1rem; color: var(--purple-3); margin-bottom: 15px; text-transform: uppercase; }
        .admin-input-group { display: flex; gap: 10px; margin-bottom: 10px; }
        .admin-input-group input { flex: 1; background: rgba(0,0,0,0.3); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 12px; color: #fff; outline: none; }
        .admin-btn { background: var(--purple-1); color: #fff; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.3s; }
        .admin-btn:hover { background: var(--purple-2); }
        .admin-btn.danger { background: var(--red); }
        .admin-list { background: rgba(0,0,0,0.2); border-radius: 10px; padding: 15px; max-height: 200px; overflow-y: auto; }
        .admin-list-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.85rem; }

        /* --- Пополнение --- */
        .deposit-box { background: linear-gradient(135deg, #1a0f2e, #2a1045); border: 1px solid var(--gold-1); border-radius: 16px; padding: 20px; text-align: center; margin-top: 20px; }
        .deposit-box p { color: var(--gold-1); font-weight: 700; font-size: 0.9rem; }
        .deposit-box small { color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 5px; }

        /* --- Уведомления --- */
        #toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--bg-panel); border: 1px solid var(--purple-2); padding: 15px 30px; border-radius: 12px; font-weight: 600; box-shadow: 0 10px 30px rgba(0,0,0,0.5); transition: 0.4s; z-index: 2000; text-align: center; }
        #toast.show { transform: translateX(-50%) translateY(0); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <!-- ЭКРАН АВТОРИЗАЦИИ -->
    <div id="auth-screen">
        <div class="auth-box glass">
            <h1>НЯШКА ДРОП</h1>
            <p>Лучшие кейсы CS2 с RTP 98%</p>
            <input type="text" id="auth-username" class="auth-input" placeholder="Юзернейм (@ник)">
            <input type="password" id="auth-password" class="auth-input" placeholder="Пароль">
            <button class="auth-btn" id="auth-btn" onclick="handleAuth()">Войти</button>
            <div class="auth-switch" onclick="toggleAuth()">Нет аккаунта? <span>Регистрация</span></div>
            <div class="deposit-box" style="margin-top: 20px;">
                <p>Хочешь пополнить? Пиши @Sigma</p>
                <small>(на первое пополнение x2)</small>
            </div>
        </div>
    </div>

    <!-- ОСНОВНОЙ САЙТ -->
    <div id="main-app" style="display: none;">
        <header>
            <div class="logo">👻 НЯШКА ДРОП</div>
            <div style="display: flex; align-items: center; gap: 15px;">
                <div class="header-balance"><span class="star">★</span> <span id="header-balance">0</span> зв</div>
                <div class="profile-btn" onclick="showProfile()">👤</div>
            </div>
        </header>

        <div class="container">
            <!-- ПРОФИЛЬ -->
            <div id="profile-section" style="display: none; margin-bottom: 30px;">
                <div class="glass" style="padding: 25px; display: flex; align-items: center; gap: 20px;">
                    <div style="font-size: 3rem; background: var(--purple-1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px var(--purple-glow);">👤</div>
                    <div>
                        <h2 style="font-size: 1.5rem;" id="profile-name">@user</h2>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Баланс: <span style="color: var(--gold-1); font-weight: 800;" id="profile-balance">0</span> зв</p>
                        <button class="admin-btn" style="margin-top: 10px; padding: 8px 15px; font-size: 0.8rem;" onclick="showAdminPanel()">Админ-панель</button>
                    </div>
                </div>
            </div>

            <!-- КЕЙСЫ -->
            <div class="section-title">ПОПУЛЯРНЫЕ КЕЙСЫ</div>
            <div class="cases-grid" id="cases-container">
                <!-- Заполняется JS -->
            </div>

            <!-- АПГРЕЙД -->
            <div class="section-title">АПГРЕЙД</div>
            <div class="upgrade-container">
                <div class="upgrade-box">
                    <h3>Ваш предмет</h3>
                    <div id="upgrade-source">
                        <div class="upgrade-item-img">❓</div>
                        <div class="upgrade-item-name">Выберите предмет</div>
                        <div class="upgrade-item-price">из инвентаря</div>
                    </div>
                    <button class="upgrade-btn" onclick="openInventory()">Выбрать из инвентаря</button>
                </div>
                <div class="upgrade-box">
                    <h3>Шанс апгрейда</h3>
                    <div class="chance-display" id="chance-display">50%</div>
                    <input type="range" class="chance-slider" id="chance-slider" min="1" max="95" value="50" oninput="updateChance()">
                    <div style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 15px;">Выигрыш: <span id="upgrade-target" style="color: var(--gold-1); font-weight: 800;">0</span> зв</div>
                    <button class="upgrade-btn" id="upgrade-action-btn" onclick="executeUpgrade()" disabled>Апгрейд</button>
                </div>
            </div>

            <!-- ИНВЕНТАРЬ -->
            <div class="section-title" id="inventory-title" style="display: none;">ИНВЕНТАРЬ</div>
            <div class="inventory-grid" id="inventory-container" style="display: none;">
                <!-- Заполняется JS -->
            </div>

            <!-- ВЫВОД -->
            <div class="section-title">ВЫВОД СРЕДСТВ</div>
            <div class="glass" style="padding: 25px; text-align: center;">
                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 15px;">Минимальная сумма вывода: 15 звёзд</p>
                <div class="admin-input-group" style="max-width: 400px; margin: 0 auto;">
                    <input type="number" id="withdraw-amount" placeholder="Сумма (от 15 зв)" min="15">
                    <button class="admin-btn" onclick="requestWithdraw()">Вывести</button>
                </div>
            </div>

            <!-- ТАБЛИЦА ЛИДЕРОВ -->
            <div class="section-title">ТАБЛИЦА ЛИДЕРОВ</div>
            <div class="leaderboard" id="leaderboard-container">
                <!-- Заполняется JS -->
            </div>
        </div>
    </div>

    <!-- АДМИН-ПАНЕЛЬ -->
    <div id="admin-panel">
        <div class="admin-content">
            <div class="admin-header">
                <h2>👑 АДМИН-ПАНЕЛЬ</h2>
                <button class="close-admin" onclick="closeAdminPanel()">&times;</button>
            </div>
            
            <div class="admin-section">
                <h3>Управление игроками</h3>
                <div class="admin-input-group">
                    <input type="text" id="admin-user" placeholder="Никнейм игрока">
                    <input type="number" id="admin-amount" placeholder="Сумма">
                </div>
                <div style="display: flex; gap: 10px;">
                    <button class="admin-btn" onclick="adminAddStars()">Добавить звёзды</button>
                    <button class="admin-btn danger" onclick="adminRemoveStars()">Убавить звёзды</button>
                </div>
            </div>

            <div class="admin-section">
                <h3>Заявки на вывод</h3>
                <div class="admin-list" id="admin-withdrawals">
                    <div class="admin-list-item">Нет активных заявок</div>
                </div>
            </div>
        </div>
    </div>

    <!-- УВЕДОМЛЕНИЯ -->
    <div id="toast">Сообщение</div>

    <script>
        // === ЗАЩИТА ОТ ПРОСМОТРА КОДА (базовая обфускация) ===
        const _0x4f2a = ['\x35\x30\x30\x35\x32\x39\x31\x36']; // 50052916
        function checkAdminPass(pass) {
            return pass === atob('NTAwNTI5MTY=');
        }

        // === ДАННЫЕ ===
        const SKINS = [
            { name: 'AWP Dragon Lore', price: 8500, rarity: 'legendary', img: '🐉' },
            { name: 'Karambit Fade', price: 3200, rarity: 'legendary', img: '🔪' },
            { name: 'M4A4 Howl', price: 5100, rarity: 'legendary', img: '🐺' },
            { name: 'Butterfly Knife', price: 2890, rarity: 'epic', img: '🦋' },
            { name: 'Glock Fade', price: 1200, rarity: 'epic', img: '🔫' },
            { name: 'AWP Asiimov', price: 890, rarity: 'rare', img: '⚡' },
            { name: 'AK-47 Redline', price: 245, rarity: 'rare', img: '🔴' },
            { name: 'Sport Gloves', price: 3800, rarity: 'legendary', img: '🧤' },
            { name: 'M9 Bayonet', price: 2100, rarity: 'epic', img: '🗡️' },
            { name: 'USP-S Kill Confirmed', price: 450, rarity: 'rare', img: '💀' },
            { name: 'Desert Eagle Blaze', price: 600, rarity: 'rare', img: '🔥' },
            { name: 'AK-47 Fire Serpent', price: 1800, rarity: 'epic', img: '🐍' },
            { name: 'AWP Neo-Noir', price: 350, rarity: 'rare', img: '🎭' },
            { name: 'M4A1-S Printstream', price: 420, rarity: 'rare', img: '🖨️' },
            { name: 'Glock Water Elemental', price: 150, rarity: 'common', img: '💧' },
            { name: 'P250 Asiimov', price: 80, rarity: 'common', img: '🤖' },
            { name: 'Five-SeveN Case Hardened', price: 95, rarity: 'common', img: '🔵' },
            { name: 'MP9 Hydra', price: 60, rarity: 'common', img: '🐲' },
            { name: 'Nova Hyper Beast', price: 110, rarity: 'common', img: '👹' },
            { name: 'XM1014 Tranquility', price: 70, rarity: 'common', img: '🌿' },
            { name: 'Galil AR Chatterbox', price: 200, rarity: 'rare', img: '📻' },
            { name: 'FAMAS Roll Cage', price: 130, rarity: 'common', img: '🏎️' },
            { name: 'SG 553 Cyrex', price: 90, rarity: 'common', img: '🔫' },
            { name: 'AUG Chameleon', price: 75, rarity: 'common', img: '🦎' },
            { name: 'SSG 08 Blood in the Water', price: 500, rarity: 'rare', img: '🩸' },
            { name: 'MAC-10 Neon Rider', price: 180, rarity: 'common', img: '🏍️' },
            { name: 'UMP-45 Primal Saber', price: 100, rarity: 'common', img: '🐾' },
            { name: 'P90 Asiimov', price: 140, rarity: 'common', img: '🤖' },
            { name: 'Tec-9 Fuel Injector', price: 160, rarity: 'common', img: '⛽' },
            { name: 'CZ75 Victoria', price: 220, rarity: 'rare', img: '👑' },
            { name: 'Dual Berettas Melondrama', price: 85, rarity: 'common', img: '🍉' },
            { name: 'R8 Revolver Fade', price: 300, rarity: 'rare', img: '🌪️' },
            { name: 'Negev Mjolnir', price: 250, rarity: 'rare', img: '🔨' },
            { name: 'M249 Aztec', price: 55, rarity: 'common', img: '🏛️' },
            { name: 'Sawed-Off The Kraken', price: 120, rarity: 'common', img: '🐙' },
            { name: 'Mag-7 Justice', price: 65, rarity: 'common', img: '⚖️' },
            { name: 'PP-Bizon Judgement of Anubis', price: 190, rarity: 'common', img: '🐺' },
            { name: 'MP7 Bloodsport', price: 210, rarity: 'rare', img: '🏆' },
            { name: 'MP5-SD Phosphor', price: 105, rarity: 'common', img: '🟢' },
            { name: 'SCAR-20 Bloodsport', price: 230, rarity: 'rare', img: '🩸' },
            { name: 'G3SG1 The Executioner', price: 170, rarity: 'common', img: '⚔️' },
            { name: 'M4A4 The Emperor', price: 750, rarity: 'epic', img: '👑' },
            { name: 'AK-47 The Empress', price: 680, rarity: 'epic', img: '👸' },
            { name: 'AWP Wildfire', price: 550, rarity: 'rare', img: '🔥' },
            { name: 'Desert Eagle Code Red', price: 400, rarity: 'rare', img: '🚨' },
            { name: 'USP-S Neo-Noir', price: 380, rarity: 'rare', img: '🎭' },
            { name: 'Glock Neo-Noir', price: 360, rarity: 'rare', img: '🎭' },
            { name: 'M4A1-S Golden Coil', price: 340, rarity: 'rare', img: '🐍' },
            { name: 'AK-47 Vulcan', price: 800, rarity: 'epic', img: '🌋' },
            { name: 'AWP Lightning Strike', price: 950, rarity: 'epic', img: '⚡' },
            { name: 'Karambit Doppler', price: 4500, rarity: 'legendary', img: '🔪' },
            { name: 'Bayonet Tiger Tooth', price: 2800, rarity: 'legendary', img: '🐯' },
            { name: 'Flip Knife Marble Fade', price: 1900, rarity: 'epic', img: '🌈' },
            { name: 'Gut Knife Slaughter', price: 1500, rarity: 'epic', img: '🩸' },
            { name: 'Huntsman Knife Fade', price: 2200, rarity: 'epic', img: '🌪️' },
            { name: 'Falchion Knife Case Hardened', price: 1100, rarity: 'epic', img: '🔵' },
            { name: 'Bowie Knife Crimson Web', price: 1300, rarity: 'epic', img: '🕸️' },
            { name: 'Shadow Daggers Vanilla', price: 900, rarity: 'rare', img: '🗡️' },
            { name: 'Paracord Knife Slaughter', price: 1000, rarity: 'epic', img: '🩸' },
            { name: 'Survival Knife Case Hardened', price: 850, rarity: 'rare', img: '🔵' },
            { name: 'Ursus Knife Doppler', price: 2500, rarity: 'legendary', img: '🔪' },
            { name: 'Navaja Knife Marble Fade', price: 1200, rarity: 'epic', img: '🌈' },
            { name: 'Stiletto Knife Fade', price: 2600, rarity: 'legendary', img: '🌪️' },
            { name: 'Talon Knife Tiger Tooth', price: 3500, rarity: 'legendary', img: '🐯' },
            { name: 'Classic Knife Crimson Web', price: 1800, rarity: 'epic', img: '🕸️' },
            { name: 'Nomad Knife Slaughter', price: 2000, rarity: 'epic', img: '🩸' },
            { name: 'Skeleton Knife Fade', price: 4000, rarity: 'legendary', img: '🌪️' },
            { name: 'Specialist Gloves Crimson Kimono', price: 3200, rarity: 'legendary', img: '🧤' },
            { name: 'Moto Gloves Spearmint', price: 2800, rarity: 'legendary', img: '🧤' },
            { name: 'Driver Gloves King Snake', price: 2500, rarity: 'legendary', img: '🧤' },
            { name: 'Hand Wraps Cobalt Skulls', price: 2200, rarity: 'epic', img: '🧤' },
            { name: 'Hydra Gloves Case Hardened', price: 1500, rarity: 'epic', img: '🧤' },
            { name: 'Broken Fang Gloves Jade', price: 1800, rarity: 'epic', img: '🧤' },
            { name: 'Bloodhound Gloves Charred', price: 1200, rarity: 'epic', img: '🧤' },
            { name: 'AK-47 Case Hardened', price: 700, rarity: 'epic', img: '🔵' },
            { name: 'M4A1-S Blue Phosphor', price: 650, rarity: 'epic', img: '🔵' },
            { name: 'AWP Containment Breach', price: 600, rarity: 'rare', img: '☢️' },
            { name: 'Desert Eagle Printstream', price: 550, rarity: 'rare', img: '🖨️' },
            { name: 'USP-S Printstream', price: 520, rarity: 'rare', img: '🖨️' },
            { name: 'Glock Gamma Doppler', price: 480, rarity: 'rare', img: '🟢' },
            { name: 'AK-47 Neon Rider', price: 450, rarity: 'rare', img: '🏍️' },
            { name: 'M4A4 Neo-Noir', price: 420, rarity: 'rare', img: '🎭' },
            { name: 'AWP Atheris', price: 80, rarity: 'common', img: '🐍' },
            { name: 'AK-47 Slate', price: 40, rarity: 'common', img: '⬛' },
            { name: 'M4A1-S Nightmare', price: 60, rarity: 'common', img: '👹' },
            { name: 'Glock Bunsen Burner', price: 50, rarity: 'common', img: '🔥' },
            { name: 'USP-S Cortex', price: 70, rarity: 'common', img: '🧠' },
            { name: 'Desert Eagle Light Rail', price: 30, rarity: 'common', img: '🔫' },
            { name: 'P250 Nevermore', price: 45, rarity: 'common', img: '🐦‍⬛' },
            { name: 'Five-SeveN Angry Mob', price: 55, rarity: 'common', img: '👥' },
            { name: 'Tec-9 Bamboozle', price: 65, rarity: 'common', img: '🎋' },
            { name: 'CZ75 Tacticat', price: 75, rarity: 'common', img: '🐱' },
            { name: 'Dual Berettas Cobra Strike', price: 85, rarity: 'common', img: '🐍' },
            { name: 'R8 Revolver Skull Crusher', price: 95, rarity: 'common', img: '💀' },
            { name: 'MAC-10 Disco Tech', price: 105, rarity: 'common', img: '🕺' },
            { name: 'MP9 Starlight Protector', price: 115, rarity: 'common', img: '🌟' },
            { name: 'UMP-45 Wild Child', price: 125, rarity: 'common', img: '🌿' },
            { name: 'P90 Nostalgia', price: 135, rarity: 'common', img: '📼' },
            { name: 'PP-Bizon High Roller', price: 145, rarity: 'common', img: '🎲' },
            { name: 'MP7 Abyssal Apparition', price: 155, rarity: 'common', img: '👻' },
            { name: 'MP5-SD Liquidation', price: 165, rarity: 'common', img: '💧' },
            { name: 'Galil AR Signal', price: 175, rarity: 'common', img: '📡' },
            { name: 'FAMAS Mecha Industries', price: 185, rarity: 'common', img: '🤖' },
            { name: 'SG 553 Dragon Tech', price: 195, rarity: 'common', img: '🐉' },
            { name: 'AUG Death by Puppy', price: 205, rarity: 'rare', img: '🐶' }
        ];

        const CASES = [
            { id: 1, name: 'Мятная прохлада', price: 0.10, img: '🧤', badge: 'LIVE' },
            { id: 2, name: 'Синие черепа', price: 0.25, img: '👕' },
            { id: 3, name: 'ОСТОРОЖНО!', price: 0.50, img: '🟡', badge: 'HOT' },
            { id: 4, name: 'Мраморный град', price: 1.00, img: '🔪' },
            { id: 5, name: 'Северный лес', price: 1.50, img: '🗡️' },
            { id: 6, name: 'Чистая вода', price: 2.00, img: '🔫' },
            { id: 7, name: 'Черный глянец', price: 3.00, img: '⚫', badge: 'NEW' },
            { id: 8, name: 'Алмазный лёд', price: 5.00, img: '💎' },
            { id: 9, name: 'Золотая жила', price: 7.50, img: '🥇' },
            { id: 10, name: 'Няшка-Люкс', price: 10.00, img: '👑', badge: 'VIP' }
        ];

        // === СОСТОЯНИЕ ===
        let state = {
            user: null,
            isRegistering: false,
            upgradeSource: null,
            upgradeChance: 50,
            withdrawalRequests: []
        };

        // === ИНИЦИАЛИЗАЦИЯ ===
        function init() {
            const savedUser = localStorage.getItem('nyashka_user');
            if (savedUser) {
                state.user = JSON.parse(savedUser);
                showMainApp();
            }
            renderCases();
            renderLeaderboard();
        }

        // === АВТОРИЗАЦИЯ ===
        function toggleAuth() {
            state.isRegistering = !state.isRegistering;
            const btn = document.getElementById('auth-btn');
            const switchText = document.querySelector('.auth-switch');
            if (state.isRegistering) {
                btn.textContent = 'Зарегистрироваться';
                switchText.innerHTML = 'Есть аккаунт? <span>Войти</span>';
            } else {
                btn.textContent = 'Войти';
                switchText.innerHTML = 'Нет аккаунта? <span>Регистрация</span>';
            }
        }

        function handleAuth() {
            const username = document.getElementById('auth-username').value.trim();
            const password = document.getElementById('auth-password').value.trim();
            
            if (!username || !password) { showToast('Заполните все поля!'); return; }

            if (state.isRegistering) {
                if (localStorage.getItem('nyashka_' + username)) {
                    showToast('Такой ник уже занят!');
                    return;
                }
                const newUser = {
                    username: username,
                    password: password,
                    stars: 1.00, // Стартовый бонус 1 зв
                    inventory: [],
                    isAdmin: false
                };
                localStorage.setItem('nyashka_' + username, JSON.stringify(newUser));
                state.user = newUser;
                showToast('Регистрация успешна! Вам начислен 1 зв.');
                showMainApp();
            } else {
                const saved = localStorage.getItem('nyashka_' + username);
                if (!saved) { showToast('Пользователь не найден!'); return; }
                const user = JSON.parse(saved);
                if (user.password !== password) { showToast('Неверный пароль!'); return; }
                state.user = user;
                showMainApp();
            }
            saveUser();
        }

        function showMainApp() {
            document.getElementById('auth-screen').style.display = 'none';
            document.getElementById('main-app').style.display = 'block';
            updateUI();
            renderInventory();
        }

        function saveUser() {
            if (state.user) {
                localStorage.setItem('nyashka_' + state.user.username, JSON.stringify(state.user));
                localStorage.setItem('nyashka_user', JSON.stringify(state.user));
            }
        }

        function logout() {
            state.user = null;
            localStorage.removeItem('nyashka_user');
            location.reload();
        }

        // === UI ===
        function updateUI() {
            if (!state.user) return;
            document.getElementById('header-balance').textContent = state.user.stars.toFixed(2);
            document.getElementById('profile-balance').textContent = state.user.stars.toFixed(2);
            document.getElementById('profile-name').textContent = '@' + state.user.username;
        }

        function showProfile() {
            const section = document.getElementById('profile-section');
            section.style.display = section.style.display === 'none' ? 'block' : 'none';
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // === КЕЙСЫ ===
        function renderCases() {
            const container = document.getElementById('cases-container');
            container.innerHTML = CASES.map(c => `
                <div class="case-card" onclick="openCase(${c.id})">
                    ${c.badge ? `<div class="case-badge">${c.badge}</div>` : ''}
                    <div class="case-img">${c.img}</div>
                    <div class="case-name">${c.name}</div>
                    <div class="case-price">★ ${c.price.toFixed(2)} зв</div>
                </div>
            `).join('');
        }

        function openCase(id) {
            const c = CASES.find(x => x.id === id);
            if (!c) return;
            if (state.user.stars < c.price) { showToast('Недостаточно звёзд!'); return; }
            
            state.user.stars -= c.price;
            
            // 45% шанс выигрыша
            const win = Math.random() < 0.45;
            let resultSkin;
            
            if (win) {
                // Выбираем случайный скин, но с учётом цены кейса (чем дороже кейс, тем дороже скин)
                const possibleSkins = SKINS.filter(s => s.price <= c.price * 50);
                resultSkin = possibleSkins[Math.floor(Math.random() * possibleSkins.length)];
                state.user.inventory.push(resultSkin);
                showToast(`🎉 Вы выиграли ${resultSkin.name} (${resultSkin.price} зв)!`);
            } else {
                showToast(`😢 Увы, в этот раз не повезло...`);
            }
            
            saveUser();
            updateUI();
            renderInventory();
        }

        // === ИНВЕНТАРЬ ===
        function renderInventory() {
            const container = document.getElementById('inventory-container');
            const title = document.getElementById('inventory-title');
            
            if (!state.user || state.user.inventory.length === 0) {
                container.innerHTML = '<div style="color: var(--text-muted); grid-column: 1/-1; text-align: center; padding: 20px;">Инвентарь пуст</div>';
                return;
            }
            
            title.style.display = 'flex';
            container.style.display = 'grid';
            
            container.innerHTML = state.user.inventory.map((item, index) => `
                <div class="inv-item" onclick="selectUpgradeItem(${index})">
                    <div class="inv-img">${item.img}</div>
                    <div class="inv-name rarity-${item.rarity}">${item.name}</div>
                    <div class="inv-price">★ ${item.price.toFixed(2)}</div>
                </div>
            `).join('');
        }

        function openInventory() {
            const inv = document.getElementById('inventory-container');
            const title = document.getElementById('inventory-title');
            if (inv.style.display === 'none') {
                title.style.display = 'flex';
                inv.style.display = 'grid';
                renderInventory();
                showToast('Выберите предмет из инвентаря');
            } else {
                title.style.display = 'none';
                inv.style.display = 'none';
            }
        }

        // === АПГРЕЙД ===
        function selectUpgradeItem(index) {
            const item = state.user.inventory[index];
            state.upgradeSource = { ...item, index: index };
            
            document.getElementById('upgrade-source').innerHTML = `
                <div class="upgrade-item-img">${item.img}</div>
                <div class="upgrade-item-name rarity-${item.rarity}">${item.name}</div>
                <div class="upgrade-item-price">★ ${item.price.toFixed(2)}</div>
            `;
            
            document.getElementById('inventory-container').style.display = 'none';
            document.getElementById('inventory-title').style.display = 'none';
            updateChance();
            showToast('Предмет выбран!');
        }

        function updateChance() {
            const slider = document.getElementById('chance-slider');
            const chance = parseInt(slider.value);
            state.upgradeChance = chance;
            document.getElementById('chance-display').textContent = chance + '%';
            
            if (state.upgradeSource) {
                const multiplier = 100 / chance;
                const targetValue = state.upgradeSource.price * multiplier;
                document.getElementById('upgrade-target').textContent = targetValue.toFixed(2);
            }
            
            const btn = document.getElementById('upgrade-action-btn');
            btn.disabled = !state.upgradeSource;
        }

        function executeUpgrade() {
            if (!state.upgradeSource) { showToast('Выберите предмет!'); return; }
            
            const chance = state.upgradeChance / 100;
            const sourceItem = state.upgradeSource;
            
            // Удаляем предмет из инвентаря
            state.user.inventory.splice(sourceItem.index, 1);
            
            const win = Math.random() < chance;
            
            if (win) {
                const multiplier = 100 / state.upgradeChance;
                const newValue = sourceItem.price * multiplier;
                
                // Находим ближайший скин по цене
                const targetSkin = SKINS.reduce((prev, curr) => 
                    Math.abs(curr.price - newValue) < Math.abs(prev.price - newValue) ? curr : prev
                );
                
                state.user.inventory.push(targetSkin);
                showToast(`🔥 Апгрейд успешен! Вы получили ${targetSkin.name} (${targetSkin.price} зв)`);
            } else {
                showToast(`💀 Апгрейд провален! Предмет потерян.`);
            }
            
            state.upgradeSource = null;
            document.getElementById('upgrade-source').innerHTML = `
                <div class="upgrade-item-img">❓</div>
                <div class="upgrade-item-name">Выберите предмет</div>
                <div class="upgrade-item-price">из инвентаря</div>
            `;
            
            saveUser();
            updateUI();
            renderInventory();
        }

        // === ВЫВОД ===
        function requestWithdraw() {
            const amount = parseFloat(document.getElementById('withdraw-amount').value);
            if (isNaN(amount) || amount < 15) { showToast('Минимальная сумма вывода: 15 зв'); return; }
            if (state.user.stars < amount) { showToast('Недостаточно средств!'); return; }
            
            state.user.stars -= amount;
            state.withdrawalRequests.push({
                user: state.user.username,
                amount: amount,
                date: new Date().toLocaleString()
            });
            localStorage.setItem('nyashka_withdrawals', JSON.stringify(state.withdrawalRequests));
            
            saveUser();
            updateUI();
            showToast(`Заявка на вывод ${amount} зв отправлена!`);
            document.getElementById('withdraw-amount').value = '';
        }

        // === ТАБЛИЦА ЛИДЕРОВ ===
        function renderLeaderboard() {
            const container = document.getElementById('leaderboard-container');
            const users = [];
            
            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (key.startsWith('nyashka_') && key !== 'nyashka_user' && key !== 'nyashka_withdrawals') {
                    const user = JSON.parse(localStorage.getItem(key));
                    users.push(user);
                }
            }
            
            users.sort((a, b) => b.stars - a.stars);
            const top10 = users.slice(0, 10);
            
            if (top10.length === 0) {
                container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Пока нет игроков</div>';
                return;
            }
            
            container.innerHTML = top10.map((u, i) => `
                <div class="lb-row">
                    <div class="lb-rank">#${i + 1}</div>
                    <div class="lb-name">@${u.username}</div>
                    <div class="lb-stars">★ ${u.stars.toFixed(2)}</div>
                </div>
            `).join('');
        }

        // === АДМИН-ПАНЕЛЬ ===
        function showAdminPanel() {
            const pass = prompt('Введите пароль администратора:');
            if (pass === atob('NTAwNTI5MTY=')) {
                document.getElementById('admin-panel').style.display = 'block';
                loadWithdrawals();
            } else {
                showToast('Неверный пароль!');
            }
        }

        function closeAdminPanel() {
            document.getElementById('admin-panel').style.display = 'none';
        }

        function loadWithdrawals() {
            const container = document.getElementById('admin-withdrawals');
            const reqs = JSON.parse(localStorage.getItem('nyashka_withdrawals') || '[]');
            
            if (reqs.length === 0) {
                container.innerHTML = '<div class="admin-list-item">Нет активных заявок</div>';
                return;
            }
            
            container.innerHTML = reqs.map((r, i) => `
                <div class="admin-list-item">
                    <span>@${r.user} — ${r.amount} зв</span>
                    <span style="color: var(--text-muted); font-size: 0.7rem;">${r.date}</span>
                </div>
            `).join('');
        }

        function adminAddStars() {
            const username = document.getElementById('admin-user').value.trim();
            const amount = parseFloat(document.getElementById('admin-amount').value);
            
            if (!username || isNaN(amount)) { showToast('Заполните поля!'); return; }
            
            const saved = localStorage.getItem('nyashka_' + username);
            if (!saved) { showToast('Игрок не найден!'); return; }
            
            const user = JSON.parse(saved);
            user.stars += amount;
            localStorage.setItem('nyashka_' + username, JSON.stringify(user));
            
            if (state.user && state.user.username === username) {
                state.user.stars = user.stars;
                saveUser();
                updateUI();
            }
            
            showToast(`Игроку @${username} добавлено ${amount} зв`);
            document.getElementById('admin-user').value = '';
            document.getElementById('admin-amount').value = '';
        }

        function adminRemoveStars() {
            const username = document.getElementById('admin-user').value.trim();
            const amount = parseFloat(document.getElementById('admin-amount').value);
            
            if (!username || isNaN(amount)) { showToast('Заполните поля!'); return; }
            
            const saved = localStorage.getItem('nyashka_' + username);
            if (!saved) { showToast('Игрок не найден!'); return; }
            
            const user = JSON.parse(saved);
            user.stars = Math.max(0, user.stars - amount);
            localStorage.setItem('nyashka_' + username, JSON.stringify(user));
            
            if (state.user && state.user.username === username) {
                state.user.stars = user.stars;
                saveUser();
                updateUI();
            }
            
            showToast(`У игрока @${username} убавлено ${amount} зв`);
            document.getElementById('admin-user').value = '';
            document.getElementById('admin-amount').value = '';
        }

        // === ЗАПУСК ===
        window.onload = init;
    </script>

<script>
/* ==== ЗАЩИТА ОТ DEVTOOLS ==== */
(function(){
  'use strict';
  let _tc=0,_tt=null;
  window._secTap=function(){
    _tc++;
    clearTimeout(_tt);
    _tt=setTimeout(function(){_tc=0;},1500);
    if(_tc>=5){_tc=0;openModal('_xA1');}
  };

  // Блок горячих клавиш
  document.addEventListener('keydown',function(e){
    const k=e.key||'';
    if(k==='F12' ||
       (e.ctrlKey&&e.shiftKey&&(k==='I'||k==='i'||k==='J'||k==='j'||k==='C'||k==='c')) ||
       (e.ctrlKey&&(k==='u'||k==='U')) ||
       (e.metaKey&&e.altKey&&(k==='I'||k==='i'||k==='J'||k==='j'))){
      e.preventDefault();e.stopPropagation();return false;
    }
  },true);

  // Блок правого клика
  document.addEventListener('contextmenu',function(e){e.preventDefault();return false;});

  // Детект открытых DevTools по размеру окна
  let _bad=false;
  function _kill(){
    document.body.innerHTML='<div style="position:fixed;inset:0;background:#07030d;color:#ef4444;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:2147483647;font-family:Arial,sans-serif;text-align:center;padding:20px"><div style="font-size:5rem">&#128683;</div><h1 style="font-size:1.6rem;margin:18px 0;color:#fff;letter-spacing:2px">DEVTOOLS</h1><p style="opacity:.7;font-size:.9rem;max-width:340px">&#1047;&#1072;&#1082;&#1088;&#1086;&#1081; &#1080;&#1085;&#1089;&#1090;&#1088;&#1091;&#1084;&#1077;&#1085;&#1090;&#1099; &#1088;&#1072;&#1079;&#1088;&#1072;&#1073;&#1086;&#1090;&#1095;&#1080;&#1082;&#1072; &#1080; &#1086;&#1073;&#1085;&#1086;&#1074;&#1080; &#1089;&#1090;&#1088;&#1072;&#1085;&#1080;&#1094;&#1091;</p></div>';
    setTimeout(function(){location.reload();},2500);
  }
  function _detect(){
    const wd=window.outerWidth-window.innerWidth;
    const hd=window.outerHeight-window.innerHeight;
    if(wd>220||hd>220){_bad=true;}
  }
  setInterval(_detect,1200);
  setInterval(function(){if(_bad){_bad=false;_kill();}},1400);

  // Debugger-ловушка (замораживает отладку)
  setInterval(function(){
    const t0=performance.now();
    try{(function(){return false;}).constructor('debugger')();}catch(e){}
    if(performance.now()-t0>150){_bad=true;}
  },4500);

  // Предупреждение в консоли
  try{
    console.log('%c\u26D4 STOP!','color:#ef4444;font-size:44px;font-weight:900;text-shadow:0 0 20px red;');
    console.log('%c\u042d\u0442\u043e \u0437\u0430\u0449\u0438\u0449\u0451\u043d\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430. \u041d\u0435 \u0432\u0432\u043e\u0434\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u0432 \u043a\u043e\u043d\u0441\u043e\u043b\u044c!','color:#fbbf24;font-size:16px;');
  }catch(e){}
})();
</script>


<script>
(function(){
  'use strict';
  let _tc=0,_tt=null;
  window._secTap=function(){
    _tc++;
    clearTimeout(_tt);
    _tt=setTimeout(function(){_tc=0;},1500);
    if(_tc>=5){_tc=0;openModal('_xA1');}
  };
  document.addEventListener('keydown',function(e){
    const k=e.key||'';
    if(k==='F12' ||
       (e.ctrlKey&&e.shiftKey&&(k==='I'||k==='i'||k==='J'||k==='j'||k==='C'||k==='c')) ||
       (e.ctrlKey&&(k==='u'||k==='U')) ||
       (e.metaKey&&e.altKey&&(k==='I'||k==='i'||k==='J'||k==='j'))){
      e.preventDefault();e.stopPropagation();return false;
    }
  },true);
  document.addEventListener('contextmenu',function(e){e.preventDefault();return false;});
  let _bad=false;
  function _kill(){
    document.body.innerHTML='<div style="position:fixed;inset:0;background:#07030d;color:#ef4444;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:2147483647;font-family:Arial,sans-serif;text-align:center;padding:20px"><div style="font-size:5rem">&#128683;</div><h1 style="font-size:1.6rem;margin:18px 0;color:#fff;letter-spacing:2px">DEVTOOLS DETECTED</h1><p style="opacity:.7;font-size:.9rem;max-width:340px">&#1047;&#1072;&#1082;&#1088;&#1086;&#1081; &#1080;&#1085;&#1089;&#1090;&#1088;&#1091;&#1084;&#1077;&#1085;&#1090;&#1099; &#1088;&#1072;&#1079;&#1088;&#1072;&#1073;&#1086;&#1090;&#1095;&#1080;&#1082;&#1072;</p></div>';
    setTimeout(function(){location.reload();},2500);
  }
  function _detect(){
    const wd=window.outerWidth-window.innerWidth;
    const hd=window.outerHeight-window.innerHeight;
    if(wd>220||hd>220){_bad=true;}
  }
  setInterval(_detect,1200);
  setInterval(function(){if(_bad){_bad=false;_kill();}},1400);
  setInterval(function(){
    const t0=performance.now();
    try{(function(){return false;}).constructor('debugger')();}catch(e){}
    if(performance.now()-t0>150){_bad=true;}
  },4500);
  try{
    console.log('%c\u26D4 STOP!','color:#ef4444;font-size:44px;font-weight:900;');
    console.log('%c\u0417\u0430\u0449\u0438\u0449\u0451\u043d\u043d\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430.','color:#fbbf24;font-size:16px;');
  }catch(e){}
})();
</script>

</body>
</html>
